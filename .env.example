# Copy to .env and replace every placeholder before starting the Compose stack.
LITELLM_MASTER_KEY=replace-with-a-strong-sk-prefixed-key
LITELLM_SALT_KEY=replace-with-a-persistent-random-salt
# Use an alphanumeric password: Compose embeds it in the database URL.
POSTGRES_PASSWORD=replace-with-a-database-password
COMPANY_API_KEY=replace-with-company-key
VLLM_1_API_KEY=replace-with-vllm-1-key
VLLM_2_API_KEY=replace-with-vllm-2-key
